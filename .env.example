# Get your token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Admin Telegram user ID(s), comma-separated (get yours from @userinfobot)
ADMIN_IDS=123456789

# Optional — 2 GB uploads via Telegram MTProto (from https://my.telegram.org/apps)
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=your_api_hash_here

# Optional — if Telegram is blocked on your server
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Video quality: fast (480p, default) | balanced (720p) | best (1080p)
# QUALITY=fast
