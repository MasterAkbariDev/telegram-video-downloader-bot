# Get your token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Admin Telegram user ID(s), comma-separated (get yours from @userinfobot)
ADMIN_IDS=123456789

# Optional — 2 GB uploads via Telegram MTProto (from https://my.telegram.org/apps)
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=your_api_hash_here

# Optional — if Telegram is blocked on your server
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Optional — Instagram auto-login (writes data/instagram_cookies.txt +
# data/instagram_session.json). Use a throwaway/dedicated account, not your
# personal one — see README for why (risk of checkpoints/bans).
# INSTAGRAM_USERNAME=your_instagram_username
# INSTAGRAM_PASSWORD=your_instagram_password

# Strongly recommended alongside auto-login — a residential/mobile proxy.
# Instagram's risk system flags server/datacenter IPs and often rejects even
# correct credentials from them. Falls back to YTDLP_PROXY if unset.
# INSTAGRAM_PROXY=http://user:pass@residential-proxy-host:port

# Optional — enables fully automated 2FA (authenticator-app codes only, not
# SMS). Get the seed from Instagram: Settings → Two-factor authentication →
# Authentication app → "Can't scan the QR code?" (shows the text seed).
# INSTAGRAM_TOTP_SECRET=your_totp_seed

# Optional — Netscape cookies.txt (YouTube / manual Instagram cookies)
# COOKIES_FILE=/path/to/cookies.txt

# Recommended over auto-login for reliably reaching login-walled Instagram
# posts at any scale: a paid, managed Instagram data API (hikerapi.com — runs
# its own residential-proxy + account pool server-side, so this bot's server
# never performs a risky login itself). ~$0.0006/request, 100 free to start,
# used only as a last resort after free extraction fails. See README.
# HIKERAPI_KEY=your_hikerapi_key

# Optional — widens Spotify track matching to Jamendo's free/CC-licensed
# catalog, alongside the no-key SoundCloud/Audius/YouTube search already in
# place. Free registration at jamendo.com/developer.
# JAMENDO_CLIENT_ID=your_jamendo_client_id

# Optional — cap threads per ffmpeg compression (default: 2)
# FFMPEG_THREADS=2

# Optional — cap concurrent ffmpeg compressions (default: cores / FFMPEG_THREADS)
# MAX_CONCURRENT_COMPRESSIONS=2
